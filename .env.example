# Copy to .env and fill in. Values are inlined at build time (build.mjs).
# Polar storefront
SOURCE_LM_PRICE_LABEL=$29
SOURCE_LM_CHECKOUT_URL=https://polar.sh/REPLACE-ME
# Organization id (Polar dashboard → Settings → General). Every license call
# carries it; without it a key from another Polar seller would validate here.
SOURCE_LM_POLAR_ORG_ID=
# Leave empty for production. Sandbox testing: https://sandbox-api.polar.sh
# — a sandbox org id only works against the sandbox API, switch both together.
SOURCE_LM_POLAR_API=
# Free gated actions per calendar month
SOURCE_LM_FREE_QUOTA=5

# Copy to .env and fill in. Values are inlined at build time (build.mjs).
# Lemon Squeezy storefront
SOURCE_LM_PRICE_LABEL=$29
SOURCE_LM_CHECKOUT_URL=https://store.lemonsqueezy.com/checkout/buy/REPLACE-ME
# Product variant id; empty disables the cross-product check
SOURCE_LM_VARIANT_ID=
# Free gated actions per calendar month
SOURCE_LM_FREE_QUOTA=5
